<UserControl x:Class="SortMyClips.SortMyClipsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sortMyClips="clr-namespace:SortMyClips"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=sortMyClips:SortMyClipsSettingsViewModel, IsDesignTimeCreatable=False}">
    <StackPanel Margin="10">
        <TextBlock Text="{DynamicResource Settings_SortedPathText}"
                   Margin="0 0 0 5" 
                   FontWeight="Bold"/>
        <StackPanel Margin="10 0 0 10">
            <Grid Height="30"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding Path=Settings.SortedPath,
                     UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextChange_IsValidPath"
                         Margin="0 0 10 0"
                         BorderThickness="2">
                </TextBox>
                <Button Grid.Column="1"
                        Content="🗁"
                        Command="{Binding BrowseSortedFolder}"
                        HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
        
        <Separator/>

        <TextBlock Text="{DynamicResource Settings_AddUnsortedPathText}"
                   Margin="0 10 0 5" 
                   FontWeight="Bold"/>
        <StackPanel Margin="10 0 0 0">
            <Grid Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Settings_PreconfiguredPathsText}"
                           Grid.Column="0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Steam"
                        Margin="10 0 0 0"
                        Command="{Binding AddSteamPaths}" />
            </Grid>
            <Grid Height="30"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding Path=Settings.UnsortedPathInput,
                     UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="TextChange_IsValidPath"
                         Margin="0 0 10 0"
                         BorderThickness="2">
                </TextBox>
                <Button Grid.Column="1"
                        Content="🗁"
                        Command="{Binding BrowseUnsortedFolder}"
                        HorizontalAlignment="Right" />
                <Button Grid.Column="2"
                        Margin="10 0 0 0"
                        Content="Add"
                        Command="{Binding AddUnsortedFolder}" />
            </Grid>

            <ListBox ItemsSource="{Binding Path=Settings.UnsortedPaths}"
                     Margin="0 10 0 0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="X"
                                    Command="{Binding DataContext.RemoveUnsortedFolder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="{DynamicResource Settings_ClearUnsortedPathsButton}"
                    Command="{Binding ClearUnsortedPaths}" />
        </StackPanel>
    </StackPanel>
</UserControl>